// 构建工具自身（vite.config.ts / eslint.config.ts / avatar-route.ts）的 tsconfig：
// 跑在 Node 里，不要 DOM 类型
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "eslint.config.*", "vitest.config.*", "avatar-route.*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",

    // 只带 Node 类型，避免误把 @types/* 全塞进全局
    "types": ["node"],

    // vue-tsc --build 只做类型检查，不产出文件
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
