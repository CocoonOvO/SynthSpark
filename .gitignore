# Trae IDE 初始开发配置（不入库）
.trae/

# icespark 像素前端样机：只入库源码与截图，依赖与产物不入库
design/icespark-prototype/node_modules/
design/icespark-prototype/dist/
design/icespark-prototype/*.mjs
design/icespark-prototype/public/fonts/*.woff2
# 补数据脚本现画的封面（每次跑都重新生成）
design/icespark-prototype/scripts/_covers/
# 样机各轮的验收截图：由 `design/icespark-prototype/e2e/shots.mjs` / `round5.mjs` /
# `round6.mjs` / `smoke.mjs` 现场生成，随时可重跑 —— 17MB 二进制不进仓库
design/icespark-shots*/

# icespark 生产前端：源码、生成物（src/api/schema.d.ts、tokens.generated.css）与锁文件入库；
# 依赖、构建/测试产物、像素字体（756KB 二进制，由 scripts/ensure-font.mjs 备好）不入库
icespark/dist/
icespark/test-results/
icespark/playwright-report/
icespark/.eslintcache
# 像素字体（Ark Pixel 12px zh_hans）**入库**了：它是纯静态设计资产（756KB + OFL.txt），
# 而且性能预算那条线（738.23 / 800 kB）与像素渲染都是针对**这一个文件**量的 ——
# 让新 clone 现取上游会引入网络依赖与版本漂移（上游只发 zip、且不在 npm，也没法热链）。
# 兜底通道仍然留着：`npm run font:ensure`（样机副本 / ICESPARK_FONT_SRC / ICESPARK_FONT_URL）。
# 站点配置的工作副本（由 scripts/ensure-site-config.mjs 从 example 生成，部署方手改）
icespark/public/site.config.json
# 真实登录 e2e 的本地凭据（本机测试账号，不入库；也可以改用环境变量传入）
icespark/e2e/.credentials.local.json
# icespark 自己的点阵头像存储（本地文件，不入库；由 icespark/avatar-route.ts 读写，可手改）
icespark/avatars.local.json

# Vite 的依赖预构建缓存（跑 dev / preview 时自动生成，不入库）
.vite/
